NODE_ENV=development
PORT=3000
# Uma ou mais origens separadas por vírgula
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

DATABASE_URL=postgresql://screenify:screenify@localhost:5432/screenify?schema=public

ROOM_EMPTY_TIMEOUT=600

# mediasoup. Em produção: LISTEN_IP=0.0.0.0 e ANNOUNCED_IP com o IP público da VPS.
# Cada worker usa uma porta (UDP e TCP) da faixa MIN..MAX, que precisa estar aberta no firewall.
MEDIASOUP_LISTEN_IP=127.0.0.1
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40000

# Token para GET /metrics (mínimo 16 caracteres). Sem ele, o endpoint fica desativado.
# Em produção, gere um aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=

# Proxies confiáveis na frente do backend: 0 em desenvolvimento, 1 atrás do Coolify (Traefik)
TRUST_PROXY=0
# Limites de conexão WebSocket por IP (padrões pensados para redes compartilhadas, como escolas)
SOCKET_MAX_CONNECTIONS_PER_IP=50
SOCKET_NEW_CONNECTIONS_PER_MINUTE=120